# Copie este arquivo para .env e preencha os valores reais.
# O arquivo .env NUNCA deve ser commitado.

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 64
JWT_SECRET=

# ─── GitHub OAuth2 ─────────────────────────────────────────────────────────────
# Crie em: https://github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Azure  ─────────────────────────────────────────────────
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_ENCRYPTION_KEY=

# ─── Brevo (email transacional) ────────────────────────────────────────────────
# Crie uma API key em: https://app.brevo.com/settings/keys/api
# O domínio remetente precisa estar verificado no Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=vinicius710@hotmail.com
BREVO_SENDER_NAME=Suporte Andrômeda
# Defina como true para habilitar o envio real de emails (false = loga e ignora)
APP_EMAIL_ENABLED=true

# ─── App ───────────────────────────────────────────────────────────────────────
# URL base do frontend — usada para montar links em e-mails de convite.
# Dev: http://localhost:5173 — Prod: https://andromeda.ia.br (frontend URL, not the API)
APP_FRONTEND_URL=http://localhost:5173

# ─── Servidor ──────────────────────────────────────────────────────────────────
SERVER_PORT=9090

# ─── MongoDB (perfis dev/prod) ─────────────────────────────────────────────────
# Para local, o docker compose já está configurado; esta var só é lida em dev/prod
MONGODB_URI=mongodb://admin:secret@localhost:27018/andromeda?authSource=admin
